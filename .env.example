# Postgres connection string for Payload.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bordful
# Payload auth secret. Use 32 or more random characters.
PAYLOAD_SECRET=replace-with-32-plus-random-chars
# Public origin of this Next.js app.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel Blob read-write token. Empty until media uploads are wired.
BLOB_READ_WRITE_TOKEN=
# Shared secret for cron routes.
CRON_SECRET=replace-me
# Resend API key for job alert email.
RESEND_API_KEY=
# Resend API origin. Empty uses the SDK default. E2E points this at the mock.
RESEND_BASE_URL=
# When true, marketing pages own / and the board lives at /jobs.
BORDFUL_MARKETING=false
# Bordfeed API origin. Empty uses bordful.config.ts. http is allowed for mocks.
BORDFEED_BASE_URL=
# Optional paste-a-key fallback for Bordfeed. Leave empty to connect in the admin.
BORDFEED_API_KEY=
# GitHub releases endpoint for the admin update notice.
BORDFUL_RELEASES_URL=https://api.github.com/repos/craftled/bordful/releases?per_page=20
# When true, cron routes honor ?now=<ISO>. Leave unset outside tests.
BORDFUL_TEST_CLOCK=
# E2E only. Playwright reads these; they are not used by the app.
MOCK_PORT=4999
APP_PORT=3000
APP_MARKETING_PORT=3001
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_MARKETING_BASE_URL=http://127.0.0.1:3001
# Local only. Comma-separated flow ids or "all"; CI never sets it.
E2E_FLOWS=
