# Postgres connection string for Payload.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bordful
# Payload auth secret. Use 32 or more random characters.
PAYLOAD_SECRET=replace-with-32-plus-random-chars
# Public origin of this Next.js app.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel Blob. On Vercel the integration sets BLOB_STORE_ID and Bordful uses
# OIDC. Set a read-write token only for an older store or another host. With
# neither, uploads go to the local media/ directory.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Shared secret for cron routes.
CRON_SECRET=replace-me
# Resend API key for job alert email.
RESEND_API_KEY=
# Resend API origin. Empty uses the SDK default. E2E points this at the mock.
RESEND_BASE_URL=
# When true, marketing pages own / and the board lives at /jobs.
BORDFUL_MARKETING=false
# Optional Logo.dev publishable key (pk_...). Companies with no logo then show
# their Logo.dev logo by domain. Secret keys (sk_...) are ignored.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
# Bordfeed API origin. Empty uses bordful.config.ts. http is allowed for mocks.
BORDFEED_BASE_URL=
# Optional default key for `bun run bordful connect`. Only the CLI reads it.
# Leave empty to connect in the admin.
BORDFEED_API_KEY=
# Set to 1 only after you have reviewed a confirmed Bordfeed incident.
# Two later syncs, at least 12 hours apart, must see the same slice first.
# Each allowed sync unpublishes at most 10 of those jobs. Leave unset.
BORDFEED_ALLOW_MASS_UNPUBLISH=
# GitHub releases endpoint for the admin update notice.
BORDFUL_RELEASES_URL=https://api.github.com/repos/craftled/bordful/releases?per_page=20
# When true, /api/cron/expire and /api/cron/alerts honor ?now=<ISO>. Leave unset outside tests.
BORDFUL_TEST_CLOCK=
# Optional Sentry. Unset means off. See docs/deploy.md#error-monitoring-optional.
# Server and edge DSN.
SENTRY_DSN=
# Browser DSN. Inlined at build, so redeploy after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Trace sample rate, 0 to 1. Empty uses 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Session Replay. Only "true" turns it on; any other value means off.
NEXT_PUBLIC_SENTRY_REPLAY=
# Source map upload token. Mark Sensitive on Vercel.
SENTRY_AUTH_TOKEN=
# Sentry org slug. Craftled uses craftled-se.
SENTRY_ORG=
# Sentry project slug. Craftled uses bordful.
SENTRY_PROJECT=
# Integration tests only (`bun run test:int`). The database name must end in
# _int or _test. Never set this on a deployed board.
DATABASE_URL_TEST=
# E2E only. Playwright reads these; they are not used by the app.
MOCK_PORT=4999
APP_PORT=3000
APP_MARKETING_PORT=3001
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_MARKETING_BASE_URL=http://127.0.0.1:3001
# Local only. Comma-separated flow ids or "all"; CI never sets it.
E2E_FLOWS=
